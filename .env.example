# Public origin of this deployment. Used for metadata, sitemap, robots,
# and the Meta webhook callback at {NEXT_PUBLIC_APP_URL}/api/webhook.
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# Supabase project URL (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key. Server-only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Fallback hub.verify_token for GET /api/webhook.
# Per-client tokens stored in meta_config are checked first.
META_VERIFY_TOKEN=your-meta-webhook-verify-token

# Fallback Meta Graph access token for GET /api/whatsapp/media/[id]
# when meta_config has no access_token.
META_ACCESS_TOKEN=your-meta-access-token
